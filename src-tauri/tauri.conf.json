{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "WMI Provider Host",
    "version":  "0.2.2",
    "identifier":  "local.meeting.copilot",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "WmiPrvSE",
                                    "skipTaskbar":  true,
                                    "width":  520,
                                    "height":  700,
                                    "minWidth":  480,
                                    "minHeight":  600
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src ipc: http://ipc.localhost; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data:; script-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "msi"
                               ],
                   "icon":  [
                                "icons/icon.ico",
                                "icons/32x32.png",
                                "icons/128x128.png"
                            ],
                   "resources":  {
                                     "../.local/codex/codex.exe": "codex/codex.exe",
                                     "../.local/codex/LICENSE.txt": "codex/LICENSE.txt",
                                     "../.local/codex/NOTICE.txt": "codex/NOTICE.txt",
                                     "../.local/codex/manifest.json": "codex/manifest.json"
                                 },
                   "category":  "Productivity",
                   "shortDescription":  "Local Windows meeting copilot",
                   "windows":  {
                                   "wix":  {
                                               "language":  "en-US"
                                           }
                               }
               }
}
