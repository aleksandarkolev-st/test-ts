      "css": ".ds-ghost{font-family:Segoe UI,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;background:transparent;color:var(--muted,#b0bdb9);border:0;border-radius:8px;padding:6px 0;font-size:12px;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out}.ds-ghost:hover{color:#fff;background:transparent}.ds-ghost:focus-visible{outline:2px solid var(--green,#a7dfc2);outline-offset:3px;}.ds-ghost:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Account Button",
      "kind": "button",
      "refersTo": "button-account",
      "description": "Existing pale full-width ChatGPT connection action.",
      "html": "<button class=\"ds-account\">Continue with ChatGPT</button>",
      "css": ".ds-account{font-family:Segoe UI,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;border:1px solid var(--border,#394744);border-radius:8px;padding:9px 13px;font-size:13px;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out;width:100%;background:#f5f6f7;color:#15211b;font-weight:600;padding:13px;justify-content:space-between}.ds-account:hover{background:#dcebe2}.ds-account:focus-visible{outline:2px solid var(--green,#a7dfc2);outline-offset:3px;}.ds-account:disabled{opacity:.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-account{transition:none}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Setup field with external label and quiet placeholder.",
      "html": "<label class=\"ds-field-label\">Project folder<input class=\"ds-field\" placeholder=\"Choose the project you want to discuss\" /></label>",
      "css": ".ds-field-label{font-family:Segoe UI,Arial,sans-serif;display:block;font-size:13px;font-weight:500;margin-bottom:18px;color:#e8edf1}.ds-field{font-family:Segoe UI,Arial,sans-serif;display:block;margin-top:7px;width:100%;color:#e8edf1;background:#182028;border:1px solid var(--border,#394744);border-radius:8px;padding:11px;font-size:13px;caret-color:var(--green,#a7dfc2);transition:background-color 150ms ease-out,border-color 150ms ease-out}.ds-field::placeholder{color:#a5b4ae}.ds-field:focus-visible{outline:2px solid var(--green,#a7dfc2);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
    },
    {
      "name": "Setup Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Static preview of the four-section Space UI tab track; the app owns tab behavior.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Setup sections\"><button class=\"ds-tab\">Meeting</button><button class=\"ds-tab ds-tab-selected\" aria-current=\"page\">Answers</button><button class=\"ds-tab\">Context</button><button class=\"ds-tab\">Camera</button></nav>",
      "css": ".ds-nav{display:flex;width:100%;gap:4px;padding:4px;background:#182028;border-radius:8px}.ds-tab{font-family:Segoe UI,Arial,sans-serif;flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;background:transparent;border:0;color:var(--muted,#b0bdb9);border-radius:6px;padding:8px 4px;font-size:13px;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out}.ds-tab-selected{background:#283b33;color:var(--green,#a7dfc2)}.ds-tab:focus-visible{outline:2px solid var(--green,#a7dfc2);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
    {
      "name": "Code Card",
      "kind": "card",
      "refersTo": "code-card",
      "description": "Source-preserving scrollable code surface and language/copy toolbar.",
      "html": "<section class=\"ds-code-card\" aria-label=\"TypeScript code snippet\"><div class=\"ds-code-toolbar\"><span>typescript</span><button class=\"ds-copy\">Copy code</button></div><pre class=\"ds-code-pre\" tabindex=\"0\" aria-label=\"Code snippet\"><code><span class=\"ds-keyword\">const</span> answer = <span class=\"ds-number\">42</span>; <span class=\"ds-comment\">// preserve exact code</span></code></pre></section>",
      "css": ".ds-code-card{margin:16px 0;background:#11191b;border:1px solid var(--border,#394744);border-radius:8px;overflow:hidden}.ds-code-toolbar{font-family:Segoe UI,Arial,sans-serif;display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#20312a;font-size:11px;color:#b9cdc3}.ds-copy{font-family:Segoe UI,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;border:1px solid var(--border,#394744);border-radius:8px;padding:9px 13px;font-size:13px;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out;min-height:26px;font-size:11px;padding:4px 8px;background:transparent;color:#e8edf1}.ds-copy:hover{background:#34414c}.ds-copy:focus-visible{outline:2px solid var(--green,#a7dfc2);outline-offset:3px;}.ds-code-pre{margin:0;padding:14px;overflow:auto;font:13px/1.7 Consolas,'Courier New',monospace;tab-size:2;color:#e3eae6}.ds-code-pre code{font:inherit;color:inherit}.ds-keyword{color:#bce3a7}.ds-number{color:#b4c9ed}.ds-comment{color:#a1b3a9}@media(prefers-reduced-motion:reduce){.ds-copy{transition:none}}"
    },
    {
      "name": "Meeting Status",
      "kind": "custom",
      "description": "Dot plus explicit status text; color never carries the state alone.",
      "html": "<div class=\"ds-status\"><i class=\"ds-status-dot\" aria-hidden=\"true\"></i><span>Suggested answer</span></div>",
      "css": ".ds-status{font-family:Segoe UI,Arial,sans-serif;display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.2px;color:#e8edf1}.ds-status-dot{width:7px;height:7px;border-radius:50%;background:var(--green,#a7dfc2)}"
    }
  ],
  "narrative": {
    "northStar": "The interview companion",
    "overview": "Meeting Copilot pairs a quiet Windows-style control surface with a small, original pixel robot. Dark slate surfaces and soft mint accents give setup and reading a shared identity. The personality lives in the companion, the italic wordmark, and direct, reassuring copy; controls remain calm and familiar.\n\nDensity changes with the task. Setup groups practical choices into four sections; the overlay gives priority to the answer and its exact code. The companion appears in setup and the empty reading state. Motion stays around that companion or in brief control feedback, leaving streamed answers clear and steady.",
    "keyCharacteristics": [
      "Dark slate foundations, one soft mint action accent.",
      "Familiar native typography with a restrained italic wordmark.",
      "Source-faithful, selectable code in a dedicated reading surface.",
      "A pixel companion whose effects stay local and respect reduced motion.",
      "Visible context controls and reachable keyboard reading tools."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Use mint to identify action, current state, and reading structure. Keep secondary explanation in the muted neutral.",
        "section": "colors"
      },
      {
        "name": "The Exact Source Rule",
        "body": "Syntax styling may separate code visually, but source text, indentation, selection, and copied content must remain faithful.",
        "section": "typography"
      },
      {
        "name": "The Reachable Footer Rule",
        "body": "Long questions, code, attachments, and manual input must scroll within their allocated areas while leaving overlay actions accessible.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the later stylesheet declarations as the current muted, border, and surface values.",
      "Do preserve source text, selection, horizontal code scrolling, and exact copying.",
      "Do keep context sharing explicit, visible, and removable.",
      "Do preserve focus outlines, tab semantics, and reduced-motion behavior.",
      "Do verify long-content states within the 520×700 overlay frame."
    ],
    "donts": [
      "Don't place companion effects over streamed answer text or code.",
      "Don't turn setup into a collection of independently elevated cards.",
      "Don't use the italic wordmark family for paragraphs or ordinary controls.",
      "Don't allow expanding tools to push the overlay footer outside its height budget.",
      "Don't describe browser fixtures as proof of native protection, global shortcuts, model quality, or completed live interviews."
    ]
  }
}
